#!/bin/dash

#
# MonSwitch
#

# Dmenu prompts for monitor switching
# TAGS: POSIX DASH DMENU

# TODO:
# - Conf option - check if <?>.dpi $selection exists in xresources and use that instead?
# - see disconnected ports option
# - prevent switching to disabled laptop lid?

# User time
# Prompt "Switch Monitor" con mons, multi, conf, done?

# conf
# display names from conf file
# key is name value is xrandr command string

# MON
# append mon to selmon

# Multi
# FIRST: prompt "(L->R) | Monitor" con mons done
# con mon appends mon to selmon and applies conf, done exits doing nothing
# LOOP: prompt "(L->R) | Monitor" con mons done
# con mon appends mon to selmon and applies conf, done exits doing nothing


#--------------------------------   Globals   ---------------------------------#
# is global to pass to main so the xrandr check can exit script early
xrandr_output=""

#------------------------------   Fetch xrandr   ------------------------------#
# this is done before loading all off the functions and running main() 

# Check if xrandr is accessible
if ! command -v xrandr >/dev/null 2>&1; then
    echo "xrandr is not installed or in $PATH"
    exit 1
fi

# Generate xrandr
echo "Generating xrandr"
xrandr_output=$(xrandr)
if [ -z "$xrandr_output" ]; then
    echo "xrandr output is empty" >&2
    exit 1
fi
echo "Generated xrandr"

#-----------------------------   Load Functions   -----------------------------#

# Use $xrandr_output to construct the following SPACE SEPARATED lists
#	$all_mons - all monitor ids
#	$con_mons - connected moniteor ids
#	$dis_mons -  disonnected monitor ids
# Gets passed xrandr output
gen_mon_lists ()
{
    userifs="$IFS"		# Save user $IFS
    IFS='
' ; set -f			# globing off
    for line in $1; do
	case "$line" in
	    *\ con* )
		con_mons="${con_mons}${line%% *} "
		all_mons="${all_mons}${line%% *} " ;;
	    *discon* )
		dis_mons="${dis_mons}${line%% *} "
		all_mons="$all_mons${line%% *} " ;;
	esac
    done
    IFS="$userifs"
    set +f
}

# Use dmenu to prompt and check if the $selection matches an element of $con_mons
dmenu_prompt ()
{
    selection=''
    options=''

    # Separate list by lines for dwm
    for word in $2; do
	options="${options}${word}
"				# this is good
    done
    # prompt with dmenu
    selection=$(echo "$options" $3 | dmenu -i -p "$1")
    expr "${selection# }" : "$3" 1>/dev/null && echo $selection && exit
    # Check if selection is valid
    for word in $con_mons; do
	expr "$selection" : "$word" 1>/dev/null && echo $selection && exit
    done
}

# Use Dmenu to prompt for selections to build the SPACE SEPARATED $multi-opts list
# if selection is done and no selmons are set do nothing, otherwise set selmons with selection
multi_prompt ()
{
    i=1				# keep track of how many mons being set
    sel_mons=''

    # loop over dmenu
    while true; do
	local selection=''
	selection=$(dmenu_prompt "(L->R) | Monitor #$i" "$multi_opts" "done")
	if [ "$selection" = "done" ]; then
	    if [ -z $sel_mons ]; then
		echo No Changes Made
		exit 1
	    else
		break
	    fi
	else
	    sel_mons="${sel_mons}${selection} "
	    i=$((i+1))

	    set -- $multi_opts
	    multi_opts=""
	    for word in $@; do
		case "$word" in
		    "$selection") ;;
		    *) multi_opts="${multi_opts}${word}
" ;;				# (:
		esac
	    done
	fi
    done
}

# Take SPACE SEPARATED $sel_mons list and convert it to LINE SEPERATED $sel_string
# if $sel_mons is only one item pass it or substitute it with config if match
# for multi item match ans substitute from conf file to construct LINE SEPERATED $user_string and overwrite $sel_mons.
# If conf file doesn't exist convert to line separated list
user_prefs_setup ()
{
    # check if config exists
    if [ -f "$XDG_CONFIG_HOME/monswitch/monswitch.conf" ]; then
	echo "Loading" "$XDG_CONFIG_HOME""/monswitch/monswitch.conf"
	oldIFS=$IFS
	IFS=' '
	config_file=$(cat "$XDG_CONFIG_HOME/monswitch/monswitch.conf")
	user_string=""

	for mon in $sel_mons; do
	    IFS='
'				# :)
	    for line in $config_file; do
		if [ "${line#"$mon"}" != "$line" ]; then
		    user_string="${user_string}${line}
"				# :):)
		fi
	    done
	done
	IFS=$oldIFS
	sel_string=$user_string
    else
	echo "File does not exist or is not a regular file: $XDG_CONFIG_HOME/monswitch/monswitch.conf"
	for mon in $sel_mons; do
	    user_string="${user_string}${mon}
"
	done
	sel_string=$user_string
    fi
}

# Construct the xrandr string
# 1 Construct the --off list
# 2 Construct the --auto list
gen_xrandr_string ()
{
    userifs="$IFS"
    # 1. Remove sel_mons from $all_mons and echo "--output" <resulting items> "--off"
    xrandr_unsel=$(
	IFS=' '
	for word in $all_mons; do
	    expr " $sel_mons " : '.*'$word'.*' 1>/dev/null ||
		echo "--output $word --off "
	done
		)
    # 2. Echo first $sel_mon "--auto" and loop through rest adding "--right-of"
    prev_mon=''
    xrandr_sel=$(
	IFS='
'				# :)
	set -- $sel_string # set items of $sel_mons to array
	echo "--output ${1%% *} --auto ${1#* }"
	prev_mon=$1
	shift 1 $@		# remove first array item
	# construct list of selmons and the first element of semons for the right of var
	for word in $@; do
	    echo "--output ${word%% *} --auto ${word#* } --right-of ${prev_mon%% *}"
	    prev_mon=$word
	done
	      )
    xrandr_string="${xrandr_unsel}${xrandr_sel}"
    IFS=$userifs
}

main ()
{
    all_mons=''
    dis_mons=''
    con_mons=''
    sel_string=''
    multi_opts=''
    local selection=NULL

    # Generate con_mons, dis_mons and all_mons from $xrandr_output
    gen_mon_lists "$xrandr_output"

    # Dmenu Call
    multi_opts="$con_mons"
    selection=$(dmenu_prompt "Switch Monitor" "$con_mons" "multi")

    # Check if dmenu set anything by checking if $selection is empty
    if [ -z ${selection} ]; then
	echo No Changes Made
	exit 0
    else
    if [ "$selection" = "multi" ]; then
	multi_prompt
    else
	sel_mons=$selection
    fi 
    echo SELECTED MONITORS: "$sel_mons"
    user_prefs_setup
    echo main sels $sel_string
    gen_xrandr_string
    echo xrandr $xrandr_string
    # xrandr --dryrun $xrandr_string
    xrandr $xrandr_string
    fi
}
main
