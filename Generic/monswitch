#!/bin/dash

#
# MonSwitch
#

# Dmenu prompts for monitor switching
# TAGS: POSIX DASH DMENU

# TODO:
# - Rotation from config file
# - CHECK IF XRANDR IS VALID BEFORE RUNNING DMENU
# - Conf option - check if <?>.dpi $selection exists in xresources and use that instead?
# - see disconnected ports option
# - prevent switching to disabled laptop lid?

# User time
# Prompt "Switch Monitor" con mons, multi, conf, done?

# conf
# display names from conf file
# key is name value is xrandr command string

# MON
# append mon to selmon

# Multi
# FIRST: prompt "(L->R) | Monitor" con mons done
# con mon appends mon to selmon and applies conf, done exits doing nothing
# LOOP: prompt "(L->R) | Monitor" con mons done
# con mon appends mon to selmon and applies conf, done exits doing nothing

all_mons=""
dis_mons=""
con_mons=""
xrandr_output=""

# Check if xrander is accessible
if command -v xrandr >/dev/null 2>&1; then
    echo "Generating xrandr"
else
    echo "xrandr is not installed or in $PATH"
    exit 1
fi

# Generate xrandr
xrandr_output=$(xrandr)

# Construct $all_mons, $con_mons, and $dis_mons from xrandr
gen_mon_lists ()
{
    userifs="$IFS"		# Save user $IFS
    IFS='
' ; set -f			# globing off
    for line in $xrandr_output ; do
	case "$line" in
	    *\ con* )
		con_mons="${con_mons}${line%% *} "
		all_mons="${all_mons}${line%% *} " ;;
	    *discon* )
		dis_mons="${dis_mons}${line%% *} "
		all_mons="$all_mons${line%% *} " ;;
	esac
    done
    IFS="$userifs"
    set +f
}

# dmenu prompt and check $selection
dmenu_prompt ()
{
    selection=''
    options=''

    # Separate list by lines for dwm
    for word in $2; do
	options="${options}${word}
"				# this is good
    done
    # prompt with dmenu
    selection=$(echo "$options" $3 | dmenu -i -p "$1")
    expr "${selection# }" : "$3" 1>/dev/null && echo $selection && exit
    # Check if selection is valid
    for word in $con_mons; do
	expr "$selection" : "$word" 1>/dev/null && echo $selection && exit
    done
}

multi_prompt ()
{
    i=1				# keep track of how many mons being set
    dmenu_return=''
    selection=''
    sel_mons=''

    while true; do
	local selection=$(dmenu_prompt "(L->R) | Monitor #$i" "$multi_opts" "done")
	# Gen $multi_opts if necessary
	if [ "$selection" = "done" ] ;then
	    break
	else
	    sel_mons="${sel_mons}${selection} "
	    i=$((i+1))

	    set -- $multi_opts
	    multi_opts=""
	    for word in $@; do
		case "$word" in
		    "$selection") ;;
		    *) multi_opts="${multi_opts}${word}
" ;;				# (:
		esac
	    done
	fi
    done
}

# replace $sel_mons list with list with parameters from config
# if $sel_mons is only one item pass it or substitute it with config if match
# for multi item match ans substitute from conf file to construct $user_string and overwrite $sel_mons
user_prefs_setup ()
{
    # check if config exists
    if [ -f "$XDG_CONFIG_HOME/monswitch/monswitch.conf" ]; then
	oldIFS=$IFS
	IFS=' '
	config_file=$(cat "$XDG_CONFIG_HOME/monswitch/monswitch.conf")
	user_string=""

	for mon in $sel_mons; do
	    IFS='
'				# :)
	    for line in $config_file; do
		if [ "${line#"$mon"}" != "$line" ]; then
		    user_string="${user_string}${line}
"				# :):)
		fi
	    done
	done
	IFS=$oldIFS
	sel_mons=$user_string
    else
	echo "File does not exist or is not a regular file: $XDG_CONFIG_HOME/monswitch/monswitch.conf"
    fi
}

# Construct the xrandr string
# 1 Construct the --off list
# 2 Construct the --auto list

gen_xrandr_string ()
{
    # 1. Remove sel_mons from $all_mons and echo "--output" <resulting items> "--off"
    unsel_string=$(
	for word in $all_mons; do
	    expr " $sel_mons " : '.*'$word'.*' 1>/dev/null ||
		echo "--output $word --off "
	done
		)

    # 2. Echo first $sel_mon "--auto" and loop through rest adding "--right-of"
    prev_mon=''
    sel_string=$(

	oldIFS=$IFS
	IFS='
'				# :)
	set -- $sel_mons	# set items of $sel_mons to array

	echo "--output $1 --auto"
	prev_mon=$1
	shift 1 "$@"		# remove first array item
	# construct list of selmons and the first element of semons for the right of var
	for word in $@; do
	    echo "--output ${word} --auto --right-of ${prev_mon%% *}"
	    prev_mon=$word
	done

	IFS=$oldIFS
	      )
    xrandr_string="${unsel_string}${sel_string}"
}

main ()
{
    multi_opts=""
    local selection=NULL

    gen_mon_lists

    multi_opts="$con_mons"
    # Dmenu Call
    selection=$(dmenu_prompt "Switch Monitor" "$con_mons" "multi")

    # Check if dmenu set anything
    [ -z ${selection} ] || \
    if [ "$selection" = "multi" ]; then
	multi_prompt
	echo SELMONS $sel_mons
	user_prefs_setup
	gen_xrandr_string
	echo xrandr $xrandr_string
	# xrandr --dryrun $xrandr_string
	xrandr $xrandr_string
    else
	sel_mons=$selection
	echo SELMONS $sel_mons
	user_prefs_setup
	gen_xrandr_string
	echo xrandr $xrandr_string
	# xrandr --dryrun $xrandr_string
	xrandr $xrandr_string
    fi || return 0;
}
main
