#!/bin/bash

# Get current date and time for the specified timezone
TZ="America/New_York"
datetime=$(TZ=$TZ date +'%Y-%m-%d %H:%M:%S %Z')

# Calculate the Moon's position and constellation
moon_data=$(moon $datetime)
moon_position=$(echo "$moon_data" | awk '/^Moon position:/ {print $3}')
constellation=$(echo "$moon_data" | awk '/^Moon is located in:/ {print $5}')

# Print the results
echo "Moon position: $moon_position"
echo "Constellation: $constellation"

